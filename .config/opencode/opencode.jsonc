{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "servers": {
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--executablePath",
          "/usr/bin/chromium"
        ],
        "disabled": true
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest"
        ],
        "disabled": true
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.7.0",
          "mcp"
        ],
        "environment": {
          "GHIDRA_INSTALL_DIR": "/opt/ghidra",
          "JAVA_HOME": "/usr/lib/jvm/java-27-openjdk"
        },
        "disabled": true
      },
      "reddit": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "reddit-mcp-server@latest"
        ]
      }
    }
  }
}
