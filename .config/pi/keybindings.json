{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "app.model.cycleForward": "f2",
  "app.model.cycleBackward": "shift+f2",
  "app.thinking.cycle": "ctrl+n",
  "app.thinking.toggle": "ctrl+t",
  "app.session.togglePath": "alt+p",
  "app.models.toggleProvider": "alt+shift+p",
  "tui.altScreen.previousPrompt": ["ctrl+shift+up"],
  "tui.altScreen.nextPrompt": ["ctrl+shift+down"],
  "tui.altScreen.lineUp": ["ctrl+up"],
  "tui.altScreen.lineDown": ["ctrl+down"],
  "tui.altScreen.bottom": ["ctrl+end"],
  "tui.input.newLine": ["shift+enter", "ctrl+j", "ctrl+return", "alt+return"],
  "tui.editor.deleteWordBackward": ["ctrl+w", "alt+backspace", "ctrl+backspace"],
  "tui.editor.deleteWordForward": ["alt+d", "alt+delete", "ctrl+delete"]
}
