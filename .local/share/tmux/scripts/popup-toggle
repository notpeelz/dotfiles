#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

session_name="$(tmux display-message -p '#S')"
dir="$(tmux display-message -p '#{pane_current_path}')"

if [[ -z "$dir" ]]; then
  dir="$HOME"
fi

if [[ "$session_name" == "_popup-"* ]]; then
  tmux detach-client
else
  tmux_version="$(tmux display-message -p '#{version}')"
  if [[ "$tmux_version" == 3.8* ]]; then
    tmux display-popup -h 80% -w 80% -E -- "$SCRIPT_DIR/popup-init" "$session_name" "$dir"
  else
    tmux new-pane -O -K -x 80% -y 80% -X 10% -Y 10% -c "$dir" -- \
      env -u TMUX "$SCRIPT_DIR/popup-init" "$session_name" "$dir"
  fi
fi
